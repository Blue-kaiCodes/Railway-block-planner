# =============================================================================
# RAILWAY BLOCK PLANNER — ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Deployment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
RAILWAY_DB_PATH=data/railway_state.db

# -----------------------------------------------------------------------------
# 1. CRIS / ISRO RTIS (Real-time Train Information System) Feed Credentials
# -----------------------------------------------------------------------------
# Base URL for CRIS RTIS Enterprise Gateway
RTIS_API_BASE_URL=
# OAuth2 / API Gateway Credentials provided by CRIS
RTIS_CLIENT_ID=
RTIS_CLIENT_SECRET=
RTIS_AUTH_TOKEN=
# Mutual TLS (mTLS) Client Certificate & Private Key paths (if required by CRIS)
RTIS_MTLS_CERT_PATH=
RTIS_MTLS_KEY_PATH=
# Polling interval in seconds (default: 15.0s)
RTIS_POLL_INTERVAL_SEC=15.0

# -----------------------------------------------------------------------------
# 2. Indian Railways NTES (National Train Enquiry System) / API Setu
# -----------------------------------------------------------------------------
# NTES API Endpoint for station passage and timetable tracking
NTES_API_BASE_URL=https://apisetu.gov.in/api/railway/ntes/v1
# API Setu / Ministry of Railways API Key
NTES_API_KEY=
# Polling interval in seconds (default: 30.0s)
NTES_POLL_INTERVAL_SEC=30.0

# -----------------------------------------------------------------------------
# 3. Open Government Data Platform (data.gov.in) Timetable Reference
# -----------------------------------------------------------------------------
# data.gov.in API Key for official train schedule and station master references
OGD_API_KEY=
OGD_RESOURCE_ID=
OGD_POLL_INTERVAL_SEC=3600.0

# -----------------------------------------------------------------------------
# 4. Sensor & IoT Telemetry Ingestion Gateway
# -----------------------------------------------------------------------------
# Bearer token required in 'X-Sensor-Token' HTTP header for sensor ingest POSTs
SENSOR_INGESTION_TOKEN=test_sensor_gateway_token_2026
# Optional MQTT Broker configuration for field telemetry edge brokers
MQTT_BROKER_URL=
MQTT_TOPIC_SENSOR_EVENTS=railway/sensors/+

# -----------------------------------------------------------------------------
# 5. Development Simulation Provider (Strictly Labeled Offline Fallback)
# -----------------------------------------------------------------------------
# Set to 'true' to enable local synthetic kinematics simulator when live feeds are unconfigured
# In production with live RTIS/NTES feeds, set to 'false'.
ENABLE_SIMULATION_PROVIDER=true
SIMULATION_TICK_INTERVAL_SEC=5.0
